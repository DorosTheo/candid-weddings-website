# Copy to .env.local for local development, and add the same variables in your
# hosting provider's dashboard (e.g. Vercel → Project → Settings → Environment Variables).

# --- Site ---------------------------------------------------------------------
# Canonical URL (no trailing slash). Used for canonical tags, sitemap, OG images.
NEXT_PUBLIC_SITE_URL=https://www.candidweddingsco.com

# --- Contact form (Resend) — REQUIRED for inquiries to be delivered -----------
# Create a key at https://resend.com/api-keys (server-side only; never commit it).
RESEND_API_KEY=
# Sender address on a domain verified in Resend (Resend → Domains → add
# candidweddingsco.com and the DNS records it shows).
CONTACT_FROM_EMAIL="Candid Weddings Co. <website@candidweddingsco.com>"
# Where inquiries are delivered (defaults to info@candidweddingsco.com).
CONTACT_TO_EMAIL=info@candidweddingsco.com

# --- Optional: analytics (only load after visitor consent) --------------------
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=
# Meta Pixel ID
NEXT_PUBLIC_META_PIXEL_ID=
# Google Search Console HTML-tag verification token (content="..." value only)
GOOGLE_SITE_VERIFICATION=
